{
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "OFFLINE",
        "LIVE"
      ]
    },
    "paused": {
      "type": "boolean"
    },
    "schedule_enabled": {
      "type": "boolean"
    },
    "schedule_local_time": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "timezone": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1
    },
    "backup_root": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "actor_id": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1
    },
    "actor_build": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1
    },
    "price_evidence_uri": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "price_valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "price_minimum_usd": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]{2,6}$"
    },
    "cap_supported": {
      "type": "boolean"
    },
    "per_run_usd": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]{2,6}$"
    },
    "pilot_usd": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]{2,6}$"
    },
    "quota_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "min_free_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "max_file_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "batch_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "overlap_hours": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "mode",
    "paused",
    "schedule_enabled",
    "schedule_local_time",
    "timezone",
    "backup_root",
    "actor_id",
    "actor_build",
    "price_evidence_uri",
    "price_valid_until",
    "price_minimum_usd",
    "cap_supported",
    "per_run_usd",
    "pilot_usd",
    "quota_bytes",
    "min_free_bytes",
    "max_file_bytes",
    "batch_bytes",
    "overlap_hours"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:acg:collector:desktop_settings:1.0",
  "title": "desktop_settings Schema 1.0"
}
