{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "commit_id": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[a-f0-9]{32}$"
    },
    "previous": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "commit_id": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[a-f0-9]{32}$"
        },
        "manifest_hash": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "commit_id",
        "manifest_hash"
      ],
      "additionalProperties": false
    },
    "segment_hash": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "segment_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "event_count": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "commit_id",
    "previous",
    "segment_hash",
    "segment_bytes",
    "event_count"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:acg:collector:manifest:1.0",
  "title": "manifest Schema 1.0"
}
