{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[a-f0-9]{32}$"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "POST_UPSERT",
        "QUARANTINE",
        "TOMBSTONE",
        "CHECKPOINT",
        "JOB_STATE",
        "MEDIA_STATE",
        "ACCOUNT_STATE",
        "POLICY_STATE",
        "REVIEW_STATE",
        "SETTINGS_STATE",
        "OPERATION_LOG",
        "SCHEDULE_STATE",
        "LEGACY_IMPORT",
        "SCALE_APPROVAL"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "commit_id": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[a-f0-9]{32}$"
    },
    "source_id": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^x:[0-9]{1,32}$"
    },
    "actor_run_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "rights_policy_id": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1
    },
    "rights_policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    },
    "payload_hash": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "retention_class": {
      "const": "policy-bound",
      "type": "string"
    },
    "redaction_state": {
      "type": "string",
      "enum": [
        "NONE",
        "SANITIZED"
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "recorded_at",
    "commit_id",
    "source_id",
    "actor_run_id",
    "rights_policy_id",
    "rights_policy_version",
    "payload",
    "payload_hash",
    "retention_class",
    "redaction_state"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:acg:collector:event:1.0",
  "title": "event Schema 1.0"
}
